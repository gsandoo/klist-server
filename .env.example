# klist-server 환경변수 템플릿
# 실제 값은 .env (gitignore) 로 관리하고 SPRING_APPLICATION 이 읽도록 로컬 셋업.

# === 지도 도메인 (tour / poi / route) ===
# 한국관광공사 TourAPI (공공데이터포털 일반 인증키, Encoding 값)
TOUR_SERVICE_KEY=

# 카카오 REST API 키 (Kakao Local + Kakao Mobility 공통)
KAKAO_REST_KEY=

# === 날씨 도메인 (기존) ===
# 기상청 API 키
# WEATHER_API_KEY=

# === 인증 도메인 (JWT) ===
# Access/Refresh Token 서명용 비밀키 (HS256, 최소 32바이트 이상). 프로덕션에서는 반드시 override.
JWT_SECRET=
# Access Token 만료 시간 (ms, 기본 1시간)
JWT_ACCESS_EXPIRATION=3600000
# Refresh Token 만료 시간 (ms, 기본 14일)
JWT_REFRESH_EXPIRATION=1209600000
